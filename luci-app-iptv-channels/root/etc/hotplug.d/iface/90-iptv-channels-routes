#!/bin/sh
# iptv-channels: IPTV 口 DHCP 租约变化时, 自检 EPG 网段策略路由
# v1.2.4 起: EPG 网段路由写入独立路由表 (默认 table 100) 并用 ip rule
# 限定仅路由器自身 IPTV 源流量生效 —— 不再修改 main 表, 局域网设备
# 访问这些公网网段不受任何影响。
# 原因: 电信 IPTV DHCP 地址池会变 (10.252.96.0/19 -> 10.58.96.0/20 ...),
#       静默 renew 不触发本钩子, 每次插件运行前也会自检, 此处双保险。

[ "$INTERFACE" = "iptv" ] || exit 0
[ "$ACTION" = "ifup" ] || exit 0

# 等待 netifd 完成接口配置
sleep 3

python3 /usr/share/iptv-channels/iptv_channels.py --fix-routes
exit 0
